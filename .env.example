# Billetera de PRUEBA (https://wallet.interledger-test.dev) con la que el servidor firma las solicitudes.
# Crea una cuenta, genera una "developer key" y descarga private.key
WALLET_ADDRESS_URL=https://ilp.interledger-test.dev/tu-billetera
KEY_ID=tu-key-id
PRIVATE_KEY_PATH=./private.key
# URL pública/local de este servidor (el callback de autorización vuelve aquí)
BASE_URL=http://localhost:3000
PORT=3000
