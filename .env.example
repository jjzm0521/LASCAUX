# Billetera de PRUEBA (https://wallet.interledger-test.dev) con la que el servidor firma las solicitudes.
# Crea una cuenta, genera una "developer key" y descarga private.key
WALLET_ADDRESS_URL=https://ilp.interledger-test.dev/tu-billetera
KEY_ID=tu-key-id
PRIVATE_KEY_PATH=./private.key
# URL pública/local de este servidor (el callback de autorización vuelve aquí)
BASE_URL=http://localhost:3000
PORT=3000
# Ruta del archivo de base de datos SQLite (por defecto: ./circulos.db)
DB_PATH=./circulos.db

# Opcional — Billeteras para npm run seed (caja y miembros de ejemplo)
POT_WALLET=https://ilp.interledger-test.dev/receptor_op
WALLET_CO=https://ilp.interledger-test.dev/emisor_op
WALLET_US=https://ilp.interledger-test.dev/receptor_op
# WALLET_CO2=https://ilp.interledger-test.dev/otra-billetera
# CIRCLE_KIND=natillera

# Opcional — Dominios permitidos al registrar billeteras de miembros (protección SSRF)
ALLOWED_WALLET_HOSTS=.interledger-test.dev
